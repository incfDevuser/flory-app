{
  "expo": {
    "name": "Flory",
    "slug": "flory-app",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "floryapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "cl.flory.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "appleTeamId": "P28ZSYM5MX",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cl.flory.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6E6",
          "dark": {
            "backgroundColor": "#FFF6E6"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Flory usa tus fotos para identificar tu planta o poner una en su ficha.",
          "cameraPermission": "Flory usa la cámara para identificar tu planta o fotografiarla para su ficha.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.436744184679-h44kqgsmdc8dkqcvpbtqj0sm5fu23ddf"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "googleWebClientId": "436744184679-thnke6a785uvld50l0cv6til01o6odrt.apps.googleusercontent.com",
      "googleIosClientId": "436744184679-h44kqgsmdc8dkqcvpbtqj0sm5fu23ddf.apps.googleusercontent.com",
      "eas": {
        "projectId": "65394a79-e6f0-449a-bf2b-d200c9ceebf1"
      }
    },
    "owner": "incfdevuser"
  }
}
